<section class="section page-width">
  <div class="section-heading section-heading--page">
    <h1 class="display">{{ blog.title }}{% render 'asterisk' %}</h1>
  </div>
  {%- paginate blog.articles by 12 -%}
    <div class="article-list">
      {%- for article in blog.articles -%}
        <article class="article-card">
          <a href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
            {%- endif -%}
            <h2 class="product-card__title">{{ article.title }}</h2>
          </a>
          <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog"
}
{% endschema %}
