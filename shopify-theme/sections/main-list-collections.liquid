<section class="section page-width">
  <div class="section-heading section-heading--page">
    <h1 class="display">{{ 'collections.all_title' | t }}{% render 'asterisk' %}</h1>
  </div>
  <div class="product-grid product-grid--3">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <article class="product-card">
          <a class="product-card__link" href="{{ collection.url }}">
            <div class="product-card__media">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', alt: collection.title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <h2 class="product-card__title">{{ collection.title }}</h2>
          </a>
        </article>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list"
}
{% endschema %}
