<section class="password scheme-dark">
  <div class="page-width password__inner">
    <p class="wordmark">{{ shop.name | upcase }}{% render 'asterisk' %}</p>
    <h1 class="password__heading display">{{ section.settings.heading }}</h1>
    <hr class="rule">
    {% render 'footnote', text: section.settings.footnote %}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__row">
          <label for="PasswordEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.email' | t }}" required>
          <button type="submit" class="button">{{ 'newsletter.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'password.owner_login' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="newsletter-form__row">
          <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ 'password.error' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Åpner snart" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Det ordner seg. Legg igjen eposten, så sier vi fra." }
  ]
}
{% endschema %}
