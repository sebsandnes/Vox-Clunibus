<section class="section page-width search">
  <div class="section-heading section-heading--page">
    <h1 class="display">{{ 'search.title' | t }}{% render 'asterisk' %}</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <label for="SearchInput" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="button">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="collection__count">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <div class="product-grid product-grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="search-result">
                <a href="{{ item.url }}" class="product-card__title">{{ item.title }}</a>
                <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- assign no_results = 'search.no_results_footnote' | t -%}
        {% render 'footnote', text: no_results %}
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
