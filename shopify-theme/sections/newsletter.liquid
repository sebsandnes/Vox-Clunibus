<section class="section newsletter scheme-{{ section.settings.scheme }}">
  <div class="page-width newsletter__inner">
    <h2 class="display">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__row">
          <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.email' | t }}" required>
          <button type="submit" class="button">{{ 'newsletter.subscribe' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {% render 'footnote', text: section.settings.footnote %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "10 % på første ordre" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Få nye design før alle andre.</p>" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Ingen spam. Bare dårlige vitser, cirka én gang i måneden." },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colors",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
