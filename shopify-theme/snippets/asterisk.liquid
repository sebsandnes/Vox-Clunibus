{%- comment -%}
  The Voxclunibus asterisk. Colored with currentColor; the .asterisk class makes it Signal orange.
  Usage: {% render 'asterisk' %}
{%- endcomment -%}
<svg class="asterisk" viewBox="0 0 100 100" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round">
  <line x1="50" y1="8" x2="50" y2="92"/>
  <line x1="50" y1="8" x2="50" y2="92" transform="rotate(60 50 50)"/>
  <line x1="50" y1="8" x2="50" y2="92" transform="rotate(120 50 50)"/>
</svg>
