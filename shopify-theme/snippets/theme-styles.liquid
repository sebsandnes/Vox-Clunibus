{%- comment -%}
  Brand fonts and color tokens. Colors come from Theme settings so they can be changed in the editor.
{%- endcomment -%}
<style>
  @font-face {
    font-family: 'Anton';
    src: url('{{ 'anton-400.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('{{ 'plex-mono-400.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('{{ 'plex-mono-700.woff2' | asset_url }}') format('woff2');
    font-weight: 700;
    font-display: swap;
  }

  :root {
    --color-bg: {{ settings.color_background }};
    --color-ink: {{ settings.color_text }};
    --color-signal: {{ settings.color_accent }};
    --color-surface: {{ settings.color_surface }};
    --color-muted: {{ settings.color_text | color_modify: 'alpha', 0.64 }};
    --color-line: {{ settings.color_text | color_modify: 'alpha', 0.16 }};
    --font-display: 'Anton', 'Arial Narrow', Impact, sans-serif;
    --font-body: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --page-width: {{ settings.page_width }}px;
  }
</style>
